@page "/about"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>About | Sean</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>About Sean</h2>
            <p>Blues in the veins, rock in the bones</p>
        </div>

        <div class="grid grid-2" style="align-items:center;">
            <div class="placeholder-media" style="min-height:360px;">Artist Photo Placeholder</div>
            <div>
                <!-- TODO: Replace with real bio copy -->
                <p>
                    Raised on records of B.B. King, Freddie King, and the raw energy of classic rock,
                    Sean picked up his first guitar at age twelve and never put it down. Two decades
                    later, his sound blends the soulful bends of Delta blues with the drive of
                    70s rock, filling every room from smoky juke joints to festival stages.
                </p>
                <p>
                    Sean has shared stages with acts across the blues and rock circuit, and his
                    live shows are known for raw tone, long solos, and a deep respect for the
                    tradition he grew up on.
                </p>
            </div>
        </div>
    </div>
</section>

<RevealSection Class="section section-alt">
    <div class="container">
        <div class="section-heading">
            <h2>Gallery Snapshot</h2>
            <p>A few moments from the road</p>
        </div>
        <div class="grid grid-3">
            @foreach (var photo in snapshotPhotos)
            {
                <div class="placeholder-media" style="min-height:180px;">
                    <img src="images/@photo.Image" alt="@photo.Description" style="width:100%;height:100%;object-fit:cover;" />
                </div>
            }
        </div>
        <div style="text-align:center; margin-top:2rem;">
            <a class="btn" href="gallery">View Full Gallery</a>
        </div>
    </div>
</RevealSection>

<RevealSection Class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Press</h2>
            <p>What people are saying</p>
        </div>
        @foreach (var press in pressQuotes)
        {
            <blockquote class="blockquote-press">
                "@press.Quote"
                <br /><strong>— @press.Source</strong>
            </blockquote>
        }
    </div>
</RevealSection>

@code {
    private List<PressQuote> pressQuotes = new();
    private List<GalleryPhoto> snapshotPhotos = new();

    protected override async Task OnInitializedAsync()
    {
        var pressCsv = await Http.GetStringAsync("data/Press.csv");
        var pressRows = CsvHelper.Parse(pressCsv);
        pressQuotes = pressRows.Select(PressQuote.FromCsvRow)
                                .OrderByDescending(p => p.Date)
                                .ToList();

        var galleryCsv = await Http.GetStringAsync("data/Gallery.csv");
        var galleryRows = CsvHelper.Parse(galleryCsv);
        snapshotPhotos = galleryRows.Select(GalleryPhoto.FromCsvRow)
                                     .Where(photo => photo.Display && photo.Snapshot)
                                     .OrderByDescending(photo => photo.Date)
                                     .ToList();
    }
}
