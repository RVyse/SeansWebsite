@page "/"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>@main.PageTitle</PageTitle>

<section class="hero">
    <p class="hero-eyebrow">@main.Heading</p>
    <h1 class="hero-title">SEAN EMERY</h1>
    <p class="hero-subtitle">
        @main.Tag
    </p>
    <div class="hero-actions">
        <a class="btn btn-solid" href="tour">See Tour Dates</a>
        <a class="btn" href="music">Listen Now</a>
    </div>
</section>

<RevealSection Class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Latest Release</h2>
            <p>New music, fresh off the road</p>
        </div>
        @if (latestRelease is not null)
        {
            <div class="grid grid-2" style="max-width: 700px; margin: 0 auto;">
                <div class="placeholder-media" style="min-height:220px;">
                    <img src="images/@latestRelease.Image" alt="@latestRelease.Title" style="width:100%;height:100%;object-fit:cover;" />
                </div>
                <div class="card-body">
                    <h3 class="card-title">@latestRelease.Title</h3>
                    <p class="card-meta">@latestRelease.Type &middot; @latestRelease.DisplayYear</p>
                    @if (!string.IsNullOrWhiteSpace(latestRelease.Description))
                    {
                        <p>@latestRelease.Description</p>
                    }
                    <div class="card-links">
                        @if (latestRelease.HasSpotifyUrl)
                        {
                            <a class="btn" href="@latestRelease.SpotifyUrl">Spotify</a>
                        }
                        @if (latestRelease.HasAppleMusicUrl)
                        {
                            <a class="btn" href="@latestRelease.AppleMusicUrl">Apple Music</a>
                        }
                        @if (latestRelease.HasYoutubeUrl)
                        {
                            <a class="btn" href="@latestRelease.YoutubeUrl">YouTube</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</RevealSection>

<RevealSection Class="section section-alt">
    <div class="container">
        <div class="section-heading">
            <h2>Upcoming Shows</h2>
            <p>Catch Sean live</p>
        </div>
        <UpcomingShowDates Days="30" />
        <div style="text-align:center; margin-top:2rem;">
            <a class="btn" href="tour">View Full Tour Schedule</a>
        </div>
    </div>
</RevealSection>

<RevealSection Class="section">
    <div class="container">
        <div class="section-heading">
            <h2>From the Road</h2>
            <p>News, thoughts, and updates</p>
        </div>
        <NewsDates Days="90" />
        <div style="text-align:center; margin-top:2rem;">
            <a class="btn" href="news">Read All News</a>
        </div>
    </div>
</RevealSection>

<RevealSection Class="section section-alt">
    <div class="container" style="text-align:center;">
        <div class="section-heading">
            <h2>Follow Along</h2>
            <p>Stay connected between shows</p>
        </div>
        <div class="footer-socials home-socials" style="margin-bottom:0;">
            <SocialLinks Size="36" />
        </div>
    </div>
</RevealSection>

@code {
    private MainInfo main = new();
    private MusicRelease? latestRelease;

    protected override async Task OnInitializedAsync()
    {
        var mainCsv = await Http.GetStringAsync("data/Main.csv");
        main = MainInfo.FromCsv(CsvHelper.ParseKeyValue(mainCsv));

        var musicCsv = await Http.GetStringAsync("data/Music.csv");
        var rows = CsvHelper.Parse(musicCsv);

        latestRelease = rows.Select(MusicRelease.FromCsvRow)
                             .Where(release => release.Display)
                             .OrderByDescending(release => release.Date)
                             .FirstOrDefault();
    }
}
