@page "/videos"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>Videos | Sean</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Videos</h2>
            <p>Live performances and music videos</p>
        </div>

        <RevealSection>
            <div class="grid grid-2">
                @foreach (var video in videos)
                {
                    <div class="card">
                        <div class="placeholder-media" style="aspect-ratio:16/9;">
                            <!-- TODO: Replace with real embed, e.g.
                                 <iframe width="100%" height="100%" src="https://www.youtube.com/embed/VIDEO_ID"
                                         title="YouTube video" frameborder="0" allowfullscreen></iframe> -->
                            YouTube Embed Placeholder
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">@video.Title</h3>
                            <p class="card-meta">@video.Description</p>
                        </div>
                    </div>
                }
            </div>
        </RevealSection>
    </div>
</section>

@code {
    private List<VideoItem> videos = new();

    protected override async Task OnInitializedAsync()
    {
        var csv = await Http.GetStringAsync("data/Videos.csv");
        var rows = CsvHelper.Parse(csv);

        videos = rows.Select(VideoItem.FromCsvRow)
                      .Where(video => video.Display)
                      .ToList();
    }
}
