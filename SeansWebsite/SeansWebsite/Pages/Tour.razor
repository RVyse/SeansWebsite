@page "/tour"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>Tour | Sean</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Upcoming Shows</h2>
            <p>Come hear it live</p>
        </div>

        <RevealSection>
            <div>
                @foreach (var show in upcomingShows)
                {
                    <div class="list-item">
                        <div class="list-item-date">@show.DisplayDate</div>
                        <div class="list-item-info">
                            <h3>@show.Venue</h3>
                            <p>@show.Location</p>
                        </div>
                        <a class="btn" href="@show.Weblink">Link</a>
                    </div>
                }
            </div>
        </RevealSection>
    </div>
</section>

<RevealSection Class="section section-alt">
    <div class="container">
        <div class="section-heading">
            <h2>Past Shows</h2>
            <p>Where Sean's been</p>
        </div>
        <button class="btn" @onclick="TogglePastShows">@(showPast ? "Hide" : "Show") Past Shows</button>

        @if (showPast)
        {
            <div style="margin-top:1.5rem;">
                @foreach (var show in pastShows)
                {
                    <div class="list-item">
                        <div class="list-item-date">@show.DisplayDate</div>
                        <div class="list-item-info">
                            <h3>@show.Venue</h3>
                            <p>@show.Location</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</RevealSection>

@code {
    private bool showPast;

    private void TogglePastShows() => showPast = !showPast;

    private List<TourShow> upcomingShows = new();
    private List<TourShow> pastShows = new();

    protected override async Task OnInitializedAsync()
    {
        var csv = await Http.GetStringAsync("data/Tour.csv");
        var rows = CsvHelper.Parse(csv);
        var today = DateTime.Today;

        var shows = rows.Select(TourShow.FromCsvRow).ToList();

        upcomingShows = shows.Where(s => s.Date == DateTime.MinValue || s.Date.Date >= today)
                              .OrderBy(s => s.Date == DateTime.MinValue ? DateTime.MaxValue : s.Date)
                              .ToList();

        pastShows = shows.Where(s => s.Date != DateTime.MinValue && s.Date.Date < today)
                          .OrderByDescending(s => s.Date)
                          .ToList();
    }
}
