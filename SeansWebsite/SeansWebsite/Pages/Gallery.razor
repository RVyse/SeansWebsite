@page "/gallery"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>Gallery | Sean</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Gallery</h2>
            <p>Moments from the stage and the road</p>
        </div>

        <RevealSection>
            <div class="grid grid-3">
                @for (int i = 0; i < photos.Count; i++)
                {
                    var index = i;
                    <div class="placeholder-media gallery-item" @onclick="() => OpenLightbox(index)">
                        <img src="images/@photos[index].Image" alt="Photo @(index + 1)" style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                }
            </div>
        </RevealSection>
    </div>
</section>

@if (selectedPhoto is not null)
{
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <div class="placeholder-media lightbox-content">
            <img src="images/@photos[selectedPhoto.Value].Image" alt="Photo @(selectedPhoto.Value + 1)" style="width:100%;height:100%;object-fit:contain;" />
        </div>
    </div>
}

@code {
    private List<GalleryPhoto> photos = new();
    private int? selectedPhoto;

    private void OpenLightbox(int index) => selectedPhoto = index;
    private void CloseLightbox() => selectedPhoto = null;

    protected override async Task OnInitializedAsync()
    {
        var csv = await Http.GetStringAsync("data/Gallery.csv");
        var rows = CsvHelper.Parse(csv);

        photos = rows.Select(GalleryPhoto.FromCsvRow)
                      .Where(photo => photo.Display)
                      .ToList();
    }
}
