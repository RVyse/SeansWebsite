@page "/music"
@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

<PageTitle>Music | Sean</PageTitle>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <h2>Discography</h2>
            <p>Blues-soaked, rock-driven</p>
        </div>

        <RevealSection>
            <div class="grid grid-3">
                @foreach (var release in releases)
                {
                    <div class="card">
                        <div class="placeholder-media" style="height:220px;">
                            <img src="images/@release.Image" alt="@release.Title" style="width:100%;height:100%;object-fit:cover;" />
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">@release.Title</h3>
                            <p class="card-meta">@release.Type &middot; @release.DisplayYear</p>
                            <div class="card-links">
                                @if (release.HasSpotifyUrl)
                                {
                                    <a class="btn" href="@release.SpotifyUrl">Spotify</a>
                                }
                                @if (release.HasAppleMusicUrl)
                                {
                                    <a class="btn" href="@release.AppleMusicUrl">Apple Music</a>
                                }
                                @if (release.HasYoutubeUrl)
                                {
                                    <a class="btn" href="@release.YoutubeUrl">YouTube</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </RevealSection>
    </div>
</section>

@code {
    private List<MusicRelease> releases = new();

    protected override async Task OnInitializedAsync()
    {
        var csv = await Http.GetStringAsync("data/Music.csv");
        var rows = CsvHelper.Parse(csv);

        releases = rows.Select(MusicRelease.FromCsvRow)
                        .Where(release => release.Display)
                        .ToList();
    }
}
