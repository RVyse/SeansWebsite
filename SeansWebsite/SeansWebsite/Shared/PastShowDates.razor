@using SeansWebsite.Services
@using SeansWebsite.Shared.Domain
@inject HttpClient Http

@foreach (var show in pastShows)
{
    <div class="list-item">
        <div class="list-item-date">@show.DisplayDate</div>
        <div class="list-item-info">
            <h3>@show.Venue</h3>
            <p>@show.Location</p>
        </div>
    </div>
}

@code {
    private List<TourShow> pastShows = new();

    protected override async Task OnInitializedAsync()
    {
        var csv = await Http.GetStringAsync("data/Tour.csv");
        var rows = CsvHelper.Parse(csv);
        var today = DateTime.Today;

        var shows = rows.Select(TourShow.FromCsvRow).ToList();

        pastShows = shows.Where(s => s.Date != DateTime.MinValue && s.Date.Date < today)
                          .OrderByDescending(s => s.Date)
                          .ToList();
    }
}
